APP_NAME=WhatsApiLebytek
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error tracking (optional — P2)
SENTRY_LARAVEL_DSN=
FLARE_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lebytekapi
DB_USERNAME=lebytekapi
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (S3-compatible) — production uploads
UPLOADS_DISK=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Green API (WhatsApp intermediario)
GREEN_API_BASE_URL=https://api.green-api.com
GREEN_API_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_WEBHOOK_TOKEN=

# Incoming webhooks HMAC secret (nucleo)
WEBHOOK_SECRET=

# Production bootstrap (required for ProductionSeeder)
ADMIN_INITIAL_EMAIL=admin@sistema.local
ADMIN_INITIAL_NAME=Administrador
ADMIN_INITIAL_PASSWORD=

# Horizon dashboard access (comma-separated emails)
HORIZON_ALLOWED_EMAILS=
HORIZON_MAIL=
HORIZON_SLACK_WEBHOOK=
HORIZON_SLACK_CHANNEL=#alerts

# URL del SaaS Lebytek (skeleton) para callbacks internos opcionales
LEBYTEK_SAAS_URL=https://waapi.lebytek.com

# waapi platform service account (Sanctum token via: php artisan integration:issue-waapi-token)
WAAPI_SERVICE_EMAIL=waapi-service@lebytek.internal
WAAPI_SERVICE_NAME="waapi Platform Service"
